{
  "schema_version": 1,
  "project_id": "prj_sketch",
  "features": [
    {
      "id": "feat_profile",
      "name": "Plate sketch",
      "kind": "profile",
      "operation": "add",
      "parameters": {
        "entities": [
          {
            "id": "ent_plate",
            "kind": "rectangle",
            "operation": "add",
            "width": 100,
            "height": 60
          },
          {
            "id": "ent_bore",
