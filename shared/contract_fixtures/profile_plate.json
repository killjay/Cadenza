          {
            "id": "con_y",
            "kind": "dimension",
            "entity_id": "ent_plate",
            "parameter": "y",
            "value": 0
          },
          {
            "id": "con_width",
            "kind": "dimension",
            "entity_id": "ent_plate",
            "parameter": "width",
            "value": 100
          },
          {
            "id": "con_height",
            "kind": "dimension",
            "entity_id": "ent_plate",
            "parameter": "height",
            "value": 60
          },
          {
            "id": "con_diameter",
            "kind": "dimension",
            "entity_id": "ent_bore",
            "parameter": "diameter",
            "value": 20
          },
          {
            "id": "con_center",
            "kind": "coincident",
            "entity_a": "ent_plate",
            "entity_b": "ent_bore"
          }
        ]
