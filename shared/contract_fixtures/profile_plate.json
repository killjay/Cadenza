    "bindings": [
      {
        "feature_id": "feat_profile",
        "constraint_id": "con_width",
        "target": "value",
        "expression": "plate_width"
      },
      {
        "feature_id": "feat_profile",
        "constraint_id": "con_diameter",
        "target": "value",
        "expression": "bore_diameter"
      },
      {
        "feature_id": "feat_extrusion",
        "target": "amount",
        "expression": "thickness"
      }
    ]
