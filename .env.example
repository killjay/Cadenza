# CADenza configuration. Copy to `.env` and fill in at least one API key.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# ── AI providers ────────────────────────────────────────────────────────────
# At least one is required for the agents to run at all.
# Image input (dropping a drawing into the composer) needs Anthropic or
# OpenRouter — DeepSeek's chat endpoint is text-only and vision turns are
# auto-rerouted off it.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ── Agent routing: "provider:model" ─────────────────────────────────────────
# Defaults live in backend/cadenza_backend/config.py; override only to
# experiment. If the named provider has no key, the app falls back to one that
# does rather than failing the request.
# MODEL_COORDINATOR=deepseek:deepseek-chat
# MODEL_DRAFTSMAN=anthropic:claude-sonnet-5
# MODEL_ENGINEER=anthropic:claude-opus-5
# MODEL_MACHINIST=anthropic:claude-opus-5

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=1800
